# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Session security
# Random secret used to sign session cookies (HMAC-SHA256). Generate with:
#   openssl rand -base64 48
SESSION_SECRET=your_long_random_secret

# Key used to encrypt hospitals' external blog platform passwords at rest.
# Generate with: openssl rand -base64 48
BLOG_CREDENTIAL_ENCRYPTION_KEY=your_long_random_secret

# AI Models
# Text generation (Claude)
ANTHROPIC_API_KEY=your_anthropic_api_key

# Image generation provider selection ('openai' or 'gemini')
IMAGE_PROVIDER=openai

# Image generation API keys (both needed — provider is selected in the UI)
OPENAI_API_KEY=your_openai_api_key
GEMINI_API_KEY=your_gemini_api_key
